{
  "name": "kube-log-viewer",
  "version": "0.8.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "npm run build:core && npm run build -w @klv/cli && npm run build:web",
    "build:core": "npm run build -w @klv/core",
    "build:cli": "npm run build -w @klv/cli",
    "build:web": "npm run build -w @klv/web",
    "dev:web": "npm run dev -w @klv/web",
    "dev:desktop": "npm run dev -w @klv/desktop",
    "build:desktop": "npm run build -w @klv/desktop"
  }
}
