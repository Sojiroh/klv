{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "KLV",
  "version": "0.9.0",
  "identifier": "dev.klv.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:client -w @klv/web",
    "beforeBuildCommand": "npm run build:client -w @klv/web",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/client-dist"
  },
  "app": {
    "windows": [
      {
        "title": "KLV — Kubernetes Log Viewer",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
